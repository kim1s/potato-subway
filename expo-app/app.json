{
  "expo": {
    "name": "Potato on the Subway",
    "slug": "potato-subway",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "potato-subway",
    "icon": "./assets/heroes/hero_weekday.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/heroes/hero_weekday.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f0ee"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/heroes/hero_weekday.png",
        "backgroundColor": "#f0f0ee"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "805d1e96-80e2-419b-b5d7-af84610219dc"
      }
    },
    "owner": "kim1s"
  }
}
