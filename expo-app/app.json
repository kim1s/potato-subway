{
  "expo": {
    "name": "Potato on the Subway",
    "slug": "subway-potato",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "potato-subway",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.potatosubway.app"
    },
    "android": {
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.potatosubway.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "@react-native-firebase/app"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "805d1e96-80e2-419b-b5d7-af84610219dc"
      }
    }
  }
}
